{
  "version": 1,
  "config_schema": "testbed.schema.json",
  "kst_offset_hours": 9,
  "tick_interval_s": 1.0,
  "time_scale": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "active_scene": "S1_고속도로",
  "scenes": {
    "dir": "../scenes",
    "glob": "S[0-9]*.json",
    "schema_file": "../scenes/scene.schema.json",
    "lines_dir": "../scenes/lines",
    "line_suffix": ".json",
    "line_schema_file": "../scenes/lines/line.schema.json"
  },
  "log": {
    "dir": "../logs",
    "file": "testbed.log",
    "time_format": "%Y-%m-%d %H:%M:%S",
    "max_value_chars": 200,
    "secret_words": ["secret", "key", "token", "password", "lock"]
  },
  "db": {
    "path": "../data/testbed.db",
    "note": "시험 DB(T3). 표 정의는 schema_file 한 파일 — 판을 더할 때 마스터 한 줄 + 디테일 표 하나",
    "schema_file": "../db/schema.sql",
    "master_table": "board_master",
    "run_table": "tb_run",
    "log_table": "board_log",
    "common_columns": ["run", "tick", "key", "at", "good_until", "src"],
    "kinds": {"flow": "flow", "event": "event", "charger": "charger", "speed": "speed", "odd": "odd"},
    "src_of_kind": {"flow": "loc", "event": "gate", "charger": "data", "speed": "data", "odd": "home"},
    "time_format": "%Y-%m-%dT%H:%M:%S.%fZ",
    "journal_mode": "WAL",
    "busy_timeout_s": 5,
    "queue_max": 20000,
    "batch_max": 500,
    "flush_s": 0.5,
    "close_wait_s": 10,
    "text_max_chars": 2000,
    "try": {
      "scene": "S5_충전기상태",
      "run_seconds": 340,
      "after_ticks": 5,
      "run2_seconds": 6,
      "poll_s": 1.0,
      "tick_tolerance": 1,
      "odd_good": {"v": 1, "at": "2026-11-25T00:00:00Z", "memo": "시험 DB — 받음", "state": {"where": "S5"}},
      "odd_bad": {"v": 1, "at": "2026-11-25T00:00:00Z", "evil": "x"},
      "broken_cause": "잘못된_원인",
      "temp_db_name": "broken_test.db"
    }
  },
  "status_codes": {
    "comm_error": "1",
    "available": "2",
    "charging": "3",
    "out_of_service": "4",
    "maintenance": "5",
    "unknown": "9"
  },
  "sources": ["data", "home", "gate", "loc", "tiles"],
  "startup_fail_targets": ["stations", "lines", "app_secret", "gateway_url"],
  "bad_payload": {
    "note": "S11 나쁜 자료. targets = 대상(시험 다리 길 이름) → 낼 수 있는 나쁜 자료 종류. 값은 모두 시험용",
    "targets": {
      "stream": ["broken_json", "out_of_range", "negative_speed", "oversize"],
      "data": ["broken_json", "out_of_range", "oversize"],
      "place": ["broken_json", "out_of_range", "oversize"],
      "route": ["broken_json", "out_of_range", "oversize"]
    },
    "coord_keys": ["loc", "line"],
    "out_of_range_latlng": [99.0, 999.0],
    "negative_speed_kmh": -30,
    "broken_keep_ratio": 0.5,
    "oversize_bytes": 2097152,
    "filler_key": "pad",
    "filler_char": "x"
  },
  "geo": {
    "earth_radius_km": 6371.0088,
    "lat_min": 33.0,
    "lat_max": 38.7,
    "lng_min": 124.5,
    "lng_max": 132.0,
    "speed_max_kmh": 200,
    "accuracy_max_m": 5000
  },
  "units": {
    "seconds_per_hour": 3600,
    "report_decimals": 1,
    "ms_per_second": 1000,
    "m_per_km": 1000,
    "json_indent": 2,
    "coord_decimals": 6
  },
  "bridge": {
    "v": 1,
    "script": "../server/bridge.py",
    "run_seconds": 75,
    "secret_header": "X-EV-App-Secret",
    "secret_env": "EV_TESTBED_APP_SECRET",
    "secret_min_chars": 16,
    "lock_max_wrong": 5,
    "lock_block_s": 30,
    "allowed_origins": ["http://127.0.0.1:5173", "http://localhost:5173"],
    "cors_max_age_s": 600,
    "max_body_bytes": 16384,
    "paths": {
      "data": "/v1/data/",
      "place": "/v1/place",
      "route": "/v1/route",
      "odd": "/v1/odd",
      "health": "/v1/health",
      "stream": "/v1/test/stream",
      "scene": "/v1/test/scene"
    },
    "methods": {
      "data": "GET",
      "place": "POST",
      "route": "POST",
      "odd": "POST",
      "health": "GET",
      "stream": "GET",
      "scene": "POST"
    },
    "no_secret_paths": ["stream", "scene"],
    "source_of_path": {"data": "data", "place": "home", "route": "home", "odd": "home"},
    "gate_source": "gate",
    "loc_source": "loc",
    "data_files": {
      "meta": "^meta\\.json$",
      "stations": "^stations/([0-9]{5})\\.json$",
      "status": "^status/([0-9]{5})\\.json$",
      "status_rest": "^status/rest/([A-Za-z0-9]{1,16})\\.json$"
    },
    "data_file_max_chars": 64,
    "startup_fail_files": {
      "stations": ["meta", "stations", "status", "status_rest"],
      "lines": []
    },
    "startup_fail_lock": ["app_secret"],
    "startup_fail_close": ["gateway_url"],
    "stream_target": "stream",
    "time_scale_max": 1000,
    "fail_http": {
      "lock": 401,
      "busy": 429,
      "quota": 429,
      "bad": 400,
      "none": 404,
      "upstream": 502,
      "home_off": 504,
      "gate": 500
    },
    "codes": {
      "lock": "lock",
      "busy": "busy",
      "bad": "bad",
      "none": "none",
      "upstream": "upstream",
      "home_off": "home_off",
      "gate": "gate"
    },
    "down_code": {"data": "upstream", "home": "home_off"},
    "health_words": {"good": "good", "bad": "bad"},
    "relay_time_format": "%Y%m%d%H%M%S",
    "relay_source_note": "테스트 베드 시험 다리 — 장면 자료(실제 중계 꼴)",
    "default_responses_file": "../scenes/responses/default.json",
    "place_q_max_chars": 100,
    "odd": {
      "fields": ["v", "at", "memo", "state"],
      "required": ["v", "at"],
      "memo_max_chars": 200,
      "max_per_run": 50,
      "name_format": "odd_%Y%m%d_%H%M%S_"
    },
    "route_source": "own",
    "stream_events": {"hello": "hello", "tick": "tick", "end": "end"},
    "content_types": {
      "json": "application/json; charset=utf-8",
      "sse": "text/event-stream; charset=utf-8"
    }
  },
  "try": {
    "health_wait_s": 15,
    "poll_s": 0.2,
    "http_timeout_s": 5,
    "stream_ticks": 3,
    "seek_lead_ticks": 2,
    "stream_wait_ticks": 6,
    "tick_tolerance": 2,
    "exit_grace_s": 15,
    "scene_a": "S1_고속도로",
    "scene_b": "S5_충전기상태",
    "drop_source": "data",
    "drop_source_home": "home",
    "wrong_tries": 2,
    "place_q": "안성휴게소",
    "bad_origin": "https://evil.example",
    "files": {
      "meta": "meta.json",
      "stations": "stations/{}.json",
      "status": "status/{}.json",
      "rest": "status/rest/{}.json",
      "outside": "..%2Fconfig%2Ftestbed.json",
      "missing_zscode": "00000"
    }
  },
  "try_t4": {
    "note": "T4 스스로 시험(tools/try_t4.py). 배속은 여기서만 키운다 — 위 time_scale 은 1 그대로",
    "scale": 60,
    "per_scene_s": 8,
    "margin_s": 40,
    "http_timeout_s": 10,
    "db_wait_s": 10,
    "poll_s": 0.2,
    "tick_tolerance": 2,
    "near_km": 1.5,
    "off_line_km": 2.0,
    "line_sample_km": 0.1,
    "heading_flip_min_deg": 150,
    "edge_ticks": 10,
    "jump_ratio": 0.8,
    "probe_after_ticks": 5,
    "place_q_hit": "안성휴게소",
    "place_q_miss": "서울역",
    "odd_good": {"v": 1, "at": "2026-11-25T00:00:00Z", "memo": "T4 시험 — 받음", "state": {"where": "S10"}},
    "odd_unknown": {"evil": "x"},
    "odd_memo_char": "가",
    "order": ["S1_고속도로", "S2_제한속도", "S3_상행하행", "S4_나들목일반도로", "S5_충전기상태", "S6_정차출발튐", "S7_출처끊김",
              "S8_켤때실패_목록", "S8_켤때실패_비밀값", "S8_켤때실패_다리주소", "S9_주소검색경로", "S10_이상해기록", "S11_나쁜자료", "S12_긴주행"],
    "checks": {
      "S1_고속도로": "plain", "S2_제한속도": "speeding", "S3_상행하행": "updown", "S4_나들목일반도로": "exit",
      "S5_충전기상태": "charger", "S6_정차출발튐": "stop", "S7_출처끊김": "down",
      "S8_켤때실패_목록": "startup", "S8_켤때실패_비밀값": "startup", "S8_켤때실패_다리주소": "startup",
      "S9_주소검색경로": "ask", "S10_이상해기록": "odd", "S11_나쁜자료": "bad", "S12_긴주행": "long"
    }
  },
  "checks": {
    "root": "..",
    "py_glob": "**/*.py",
    "json_glob": "**/*.json",
    "skip_dirs": ["__pycache__", "logs", "data", ".git"],
    "hardcode": {
      "allowed_numbers": [0, 1, -1],
      "exclude_files": [],
      "path_patterns": [
        "^[A-Za-z]:[\\\\/]",
        "^\\.{1,2}[\\\\/]",
        "^/[^/\\s]",
        "\\\\",
        "^[a-zA-Z][a-zA-Z0-9+.-]*://",
        "\\.(json|py|md|db|log|txt|csv|js|html)$",
        "^\\*\\*",
        "^\\d{1,3}(\\.\\d{1,3}){3}$",
        "^localhost$"
      ]
    },
    "imports_allowed": {
      "schemacheck": [],
      "geo": [],
      "tblog": [],
      "tbconfig": ["schemacheck"],
      "check_scenes": ["tbconfig", "tblog", "schemacheck", "geo"],
      "check4": ["tbconfig", "tblog", "check_scenes", "tbdb"],
      "match_ids": ["tbconfig", "tblog"],
      "try_server": ["tbconfig", "tblog", "check_scenes"],
      "relay_view": [],
      "scene_play": ["tbconfig", "schemacheck", "geo"],
      "bridge": ["tbconfig", "tblog", "schemacheck", "scene_play", "relay_view", "recorder"],
      "tbdb": [],
      "recorder": ["tbdb"],
      "db_peek": ["tbconfig", "tblog", "tbdb"],
      "try_db": ["tbconfig", "tblog", "tbdb", "db_peek", "try_server", "recorder"],
      "pick_stations": ["geo", "match_ids", "tbconfig", "tblog"],
      "try_t4": ["tbconfig", "tblog", "tbdb", "geo", "check_scenes", "try_server"],
      "realcfg": ["tbconfig"],
      "osm_line": ["geo", "pick_stations", "realcfg", "tbconfig", "tblog"],
      "osm_fetch": ["osm_line", "realcfg", "tbconfig", "tblog"],
      "real_scene": ["check_scenes", "osm_line", "pick_stations", "realcfg", "tbconfig", "tblog"],
      "try_realline": ["check_scenes", "geo", "osm_line", "pick_stations", "realcfg", "tbconfig", "tblog"]
    }
  }
}
