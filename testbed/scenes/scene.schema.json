{
  "$comment": "장면 파일 한 개의 꼴. 설명은 같은 폴더 README.md. tools/check_scenes.py 가 이 꼴(쓰는 부분 — JSON Schema 일부)로 먼저 보고, 꼴로 못 보는 것(시간표 순서, 구간이 길을 다 덮나, 충전소 id 가 목록에 있나, 상태·출처 낱말이 설정에 있나)은 따로 본다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "title", "description", "data_source", "route", "speeds", "emit", "limits", "stations", "timeline"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "name": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "data_source": {"$ref": "#/$defs/data_source"},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legs"],
      "properties": {
        "legs": {"type": "array", "items": {"$ref": "#/$defs/leg"}}
      }
    },
    "speeds": {"type": "array", "items": {"$ref": "#/$defs/speed"}},
    "stops": {"type": "array", "items": {"$ref": "#/$defs/stop"}},
    "emit": {"$ref": "#/$defs/emit"},
    "limits": {"type": "array", "items": {"$ref": "#/$defs/limit"}},
    "stations": {"type": "array", "items": {"$ref": "#/$defs/station"}},
    "timeline": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "responses": {
      "type": "object",
      "additionalProperties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/response"}}
    },
    "compose": {"$ref": "#/$defs/compose"}
  },
  "$defs": {
    "latlng": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "number"}
    },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real", "from", "note"],
      "properties": {
        "real": {"type": "boolean"},
        "from": {"type": "string", "minLength": 1},
        "taken_at": {"type": "string"},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "leg": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "line", "from_km", "to_km"],
          "properties": {
            "kind": {"const": "line"},
            "line": {"type": "string", "minLength": 1},
            "from_km": {"type": "number", "minimum": 0},
            "to_km": {"type": "number", "minimum": 0},
            "note": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "handmade", "note", "points"],
          "properties": {
            "kind": {"const": "points"},
            "handmade": {"type": "boolean"},
            "note": {"type": "string", "minLength": 1},
            "road": {"type": "string"},
            "points": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/latlng"}}
          }
        }
      ]
    },
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leg", "from_km", "to_km", "kmh"],
      "properties": {
        "leg": {"type": "integer", "minimum": 0},
        "from_km": {"type": "number", "minimum": 0},
        "to_km": {"type": "number", "minimum": 0},
        "kmh": {"type": "number", "minimum": 0},
        "note": {"type": "string"}
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leg", "at_km", "duration_s"],
      "properties": {
        "leg": {"type": "integer", "minimum": 0},
        "at_km": {"type": "number", "minimum": 0},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "note": {"type": "string"}
      }
    },
    "emit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "accuracy_m", "heading"],
      "properties": {
        "fields": {
          "type": "array", "minItems": 1,
          "items": {"enum": ["lat", "lng", "speed_kmh", "heading_deg", "accuracy_m", "t"]}
        },
        "accuracy_m": {"type": "number", "exclusiveMinimum": 0},
        "heading": {"enum": ["from_path", "none"]},
        "speed": {"enum": ["device", "none"]},
        "note": {"type": "string"}
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leg", "from_km", "to_km", "limit_kmh"],
      "properties": {
        "leg": {"type": "integer", "minimum": 0},
        "from_km": {"type": "number", "minimum": 0},
        "to_km": {"type": "number", "minimum": 0},
        "limit_kmh": {"type": ["integer", "null"], "minimum": 0},
        "note": {"type": "string"}
      }
    },
    "charger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "kw", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["fast", "slow"]},
        "kw": {"type": "number", "minimum": 0},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "operator_station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_id", "operator", "loc", "chargers"],
      "properties": {
        "station_id": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "minLength": 1},
        "maker": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "zscode": {"type": "string", "minLength": 1},
        "zcodes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rest": {"type": "boolean"},
        "indoor": {"type": "boolean"},
        "loc": {"$ref": "#/$defs/latlng"},
        "chargers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/charger"}}
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "line", "km", "loc", "operators"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["rest", "ic", "around"]},
        "direction": {"type": "string"},
        "line": {"type": ["string", "null"]},
        "km": {"type": ["number", "null"], "minimum": 0},
        "loc": {"$ref": "#/$defs/latlng"},
        "operators": {"type": "array", "items": {"$ref": "#/$defs/operator_station"}}
      }
    },
    "event": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["t_s", "type", "station_id", "charger_id", "status"],
          "properties": {
            "t_s": {"type": "number", "minimum": 0},
            "type": {"const": "charger_status"},
            "station_id": {"type": "string", "minLength": 1},
            "charger_id": {"type": "string", "minLength": 1},
            "status": {"type": "string", "minLength": 1},
            "note": {"type": "string"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["t_s", "type", "source"],
          "properties": {
            "t_s": {"type": "number", "minimum": 0},
            "type": {"enum": ["source_down", "source_up"]},
            "source": {"type": "string", "minLength": 1},
            "reason": {"type": "string"},
            "note": {"type": "string"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["t_s", "type", "target"],
          "properties": {
            "t_s": {"type": "number", "minimum": 0, "maximum": 0},
            "type": {"const": "startup_fail"},
            "target": {"type": "string", "minLength": 1},
            "note": {"type": "string"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["t_s", "type", "offset_m", "bearing_deg", "ticks"],
          "properties": {
            "t_s": {"type": "number", "minimum": 0},
            "type": {"const": "gps_jump"},
            "offset_m": {"type": "number", "minimum": 0},
            "bearing_deg": {"type": "number", "minimum": 0, "maximum": 360},
            "ticks": {"type": "integer", "minimum": 1},
            "note": {"type": "string"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["t_s", "type", "target", "bad", "ticks"],
          "properties": {
            "t_s": {"type": "number", "minimum": 0},
            "type": {"const": "bad_payload"},
            "target": {"type": "string", "minLength": 1},
            "bad": {"enum": ["broken_json", "out_of_range", "negative_speed", "oversize"]},
            "ticks": {"type": "integer", "minimum": 1},
            "note": {"type": "string"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["t_s", "type", "path", "mode"],
          "properties": {
            "t_s": {"type": "number", "minimum": 0},
            "type": {"const": "response_mode"},
            "path": {"type": "string", "minLength": 1},
            "mode": {"type": "string", "minLength": 1},
            "note": {"type": "string"}
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "delay_ms"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "match": {"type": "string"},
        "status": {"type": "integer", "minimum": 100, "maximum": 599},
        "delay_ms": {"type": "number", "minimum": 0},
        "body": {},
        "body_file": {"type": "string"},
        "build": {"enum": ["scene_route", "odd_check"]},
        "note": {"type": "string"}
      }
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenes", "repeat_until_s"],
      "properties": {
        "scenes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "repeat_until_s": {"type": "number", "exclusiveMinimum": 0},
        "note": {"type": "string"}
      }
    }
  }
}
