  "texts": {"me": "내 위치", "only3_off": "세 곳만", "only3_on": "세 곳만 ✓"},
  "style": {
    "version": 8,
    "sources": {
      "base": {
        "type": "raster",
        "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "© OpenStreetMap contributors"
      }
    },
    "layers": [{"id": "base_raster", "type": "raster", "source": "base"}]
  },
  "tile_source_id": "base",
  "base": "vector",
  "map_options": {"localIdeographFontFamily": "'Noto Sans KR', 'Malgun Gothic', 'Apple SD Gothic Neo', sans-serif"},
  "vector": {
    "note": "(추가2) 바탕 = base 한 줄: vector(벡터 지도 — 글자가 지도를 돌려도 바로 섬, 꼴은 style_config 의 우리 밤 운전 스타일) 또는 raster(위 style — 그림 타일, 돌리면 글자도 같이 돎). 벡터 지도와 그림 타일의 출처 id 는 같은 tile_source_id. 벡터 지도를 첫 조각 전에 못 받거나 wait_ms 안에 안 오면: fallback 참 = 위 그림 타일을 우리 층(경로 선·점) 아래에 깔고(출처 id fallback_source_id) 상태 자리에 piece 한 줄(code_fallback), 거짓 = 지도 그림 끊김 한 줄(code_down). 돌아간 뒤 벡터 지도 조각이 늦게라도 오면 그림 타일을 걷고 벡터 지도로 돌아옴(한 번만 — 오락가락 없음)",
    "base_word": "vector",
    "style_config": "config_mapstyle_night",
    "fallback": true,
    "fallback_source_id": "base_fb",
    "wait_ms": 10000,
    "wait_code": "vtiles_wait",
    "piece": "conn.tiles.vector",
    "code_fallback": "vtiles_fb",
    "code_down": "vtiles",
    "word_base": "map_base",
    "word_bad": "map_vector_bad",
    "word_fallback": "map_fallback",
    "word_restore": "map_restore",
    "act_fallback": "fallback"
  },
  "start_center": [127.1, 37.27],
