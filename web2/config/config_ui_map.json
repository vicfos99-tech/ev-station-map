{
  "note": "지도(ui_map + mapview). 바탕 그림(타일) 주소는 이 파일에만 — 지도 라이브러리가 직접 받는다(설계 '바깥 주소는 하나'의 예외). 카메라 규칙 값은 config_mapcam. attribution.compact false = 좁은 지도에서도 저작권 글을 접지 않음(고칠 것 ③). others = 다른 충전소 점 층('세 곳만'이면 숨김), marks = 1·2·3번 표시(HTML 표시 — 글꼴 파일 없이, 다른 점보다 크고 위에; kinds 는 앞의 충전소·주변 모양). events.user_starts = 손으로 만진 시작 알림 → 종류(originalEvent 가 있는 것만), move_end 에 한 번 알림. store_key = 카메라 상태를 저장하는 데이터 폴더 키(config_store.keys)",
  "owner": "ui_map",
  "tiles_piece": "conn.tiles",
  "cam_piece": "map.cam",
  "fix_piece": "fix",
  "ahead_piece": "ahead",
  "stations_piece": "stations",
  "stations_list_key": "list",
  "around_mode": "around",
  "app_piece": "health.app",
  "slot_id": "ev-slot-center",
  "store_key": "mapcam",
  "ids": {"root": "ev-map-bar", "me": "ev-map-me", "only3": "ev-map-only3"},
  "pressed_attr": "aria-pressed",
  "yes_word": "true",
  "no_word": "false",
  "click_event": "click",
  "texts": {"me": "내 위치", "only3_off": "세 곳만", "only3_on": "세 곳만 ✓"},
  "style": {
    "version": 8,
    "sources": {
      "osm": {
        "type": "raster",
        "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
        "tileSize": 256,
        "maxzoom": 19,
        "attribution": "© OpenStreetMap contributors"
      }
    },
    "layers": [{"id": "osm", "type": "raster", "source": "osm"}]
  },
  "tile_source_id": "osm",
  "start_center": [127.1, 37.27],
  "attribution": {"compact": false},
  "geo": {"feature": "Feature", "point": "Point", "collection": "FeatureCollection"},
  "dot": {
    "source_id": "me",
    "source_type": "geojson",
    "layer_id": "me-dot",
    "layer_type": "circle",
    "paint": {"circle-radius": 9, "circle-color": "#2563eb", "circle-stroke-color": "#ffffff", "circle-stroke-width": 3}
  },
  "others": {
    "source_id": "stations",
    "source_type": "geojson",
    "layer_id": "stations-dot",
    "layer_type": "circle",
    "paint": {"circle-radius": 4, "circle-color": "#6b7280", "circle-stroke-color": "#ffffff", "circle-stroke-width": 1, "circle-opacity": 0.8},
    "visibility_key": "visibility",
    "shown_word": "visible",
    "hidden_word": "none"
  },
  "marks": {
    "tag": "div",
    "class": "ev-map-no",
    "kinds": {"ahead": "ev-map-no-ahead", "around": "ev-map-no-around"},
    "key_attr": "data-key",
    "anchor": "center",
    "sig_join": "|",
    "ahead_kind": "ahead",
    "around_kind": "around"
  },
  "events": {"load": "load", "data": "data", "error": "error", "move_end": "moveend", "user_starts": {"dragstart": "moved", "rotatestart": "rotated", "zoomstart": "zoomed"}},
  "tiles_wait_ms": 15000,
  "tiles_code": "tiles",
  "tiles_wait_code": "tiles_wait",
  "no_lib_code": "no_maplibre",
  "where": "ui_map",
  "act_init": "init",
  "act_user": "user",
  "act_me": "me",
  "act_only3": "only3",
  "act_load": "load",
  "act_marks": "marks",
  "act_stations": "stations",
  "word_tiles_bad": "tiles_bad",
  "word_user": "map_user",
  "word_me": "map_me",
  "word_only3": "map_only3",
  "word_save_failed": "map_save_failed",
  "word_load_failed": "map_load_failed"
}
