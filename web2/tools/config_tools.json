{
  "note": "web2 도구(check4·vendor_get·install_hook …)의 값. 경로는 web2 폴더(app_dir) 기준. 시각 차이는 work.env 의 KST_OFFSET_HOURS 를 읽는다(설계 5-6)",
  "app_dir": "..",
  "work_env": {"file": "work.env", "kst_key": "KST_OFFSET_HOURS", "root_key": "CLAUDE_WORK_ROOT"},
  "time": {"ms_per_hour": 3600000, "format": "YYYY-MM-DD hh:mm:ss"},
  "log": {"dir": "tools/logs", "suffix": ".log", "sep": " · "},
  "tmp_dir": "tools/tmp",
  "pass_word": "통과",
  "fail_word": "실패",
  "exit": {"ok": 0, "fail": 1},
  "git": {"cmd": "git"},
  "build": {
    "shell": "shell.html",
    "src_dir": "src",
    "config_dir": "config",
    "config_ext": ".json",
    "shape_dir": "config/shape",
    "shape_ext": ".shape.json",
    "module_ext": ".js",
    "out_file": "index.html",
    "stamp_file": "build.json",
    "entry_module": "app",
    "entry_export": "main",
    "module_var_prefix": "__m_",
    "export_re": "^(\\s*)export\\s+(async\\s+function|function|const|let|class)\\s+([A-Za-z_$][\\w$]*)",
    "export_word_re": "^\\s*export\\s+",
    "export_bad_re": "^\\s*export\\b",
    "screen_prefix": "ui_",
    "view_prefix": "view_",
    "view_ext": ".html",
    "style_prefix": "style_",
    "style_ext": ".css",
    "views_order": ["ui_status", "ui_drive", "ui_log"],
    "views_optional": ["ui_map", "ui_boards"],
    "board_decl": "^\\s*export\\s+const\\s+KIND\\s*=\\s*['\"]board['\"]",
    "vendor_js": ["vendor/maplibre-gl.js"],
    "vendor_css": ["vendor/maplibre-gl.css"],
    "marks": {
      "title": "@@TITLE@@", "vendor_css": "@@VENDOR_CSS@@", "styles": "@@STYLES@@", "views": "@@VIEWS@@",
      "config": "@@CONFIG@@", "vendor_js": "@@VENDOR_JS@@", "modules": "@@MODULES@@", "entry": "@@ENTRY@@", "boards": "@@BOARDS@@"
    },
    "title": "충전 길잡이 (새 앱)",
    "secret_name": "config_app_secret",
    "build_name": "config_build",
    "status_config": "config_ui_status",
    "health_config": "config_health",
    "no_commit_word": "nocommit",
    "dirty_mark": "+",
    "stamp_comment_at": "<head>",
    "stamp_label": "build",
    "json_indent": 2,
    "kb": 1024
  },
  "check4": {
    "src_dir": "src",
    "module_ext": ".js",
    "config_dir": "config",
    "shape_dir": "config/shape",
    "config_ext": ".json",
    "build_tool": "tools/build.mjs",
    "build_out_file": "index.html",
    "build_stamp_file": "build.json",
    "build_stamp_key": "stamp",
    "build_secret_test_value": "check4-build-only-secret-value",
    "build_supplied": {
      "config_app_secret": {"app_secret": "check4-build-only-secret-value"},
      "config_build": {"stamp": "check4-stamp", "at": "check4-at", "commit": "check4"}
    },
    "hardcode": {
      "allowed_numbers": [0, 1],
      "string_patterns": [
        "[\\uAC00-\\uD7A3\\u3131-\\u318E]",
        "://",
        "/",
        "\\\\\\\\",
        "\\.(json|js|mjs|html|css|md|txt|log|py)$",
        "^[A-Za-z0-9_+=-]{24,}$",
        "^\\d{1,3}(\\.\\d{1,3}){3}",
        "^localhost$"
      ],
      "allowed_strings": [],
      "banned_code": [
        "\\bget(Hours|Minutes|Seconds|Milliseconds|Day|Date|Month|FullYear|Year)\\s*\\(",
        "\\btoLocale\\w*\\s*\\(",
        "\\bgetTimezoneOffset\\b",
        "\\bwindow\\s*\\.\\s*close\\b",
        "\\balert\\s*\\(",
        "\\bconfirm\\s*\\(",
        "\\bprompt\\s*\\(",
        "hours\\s*=\\s*9"
      ],
      "http_word": "http",
      "http_ok_config_files": ["config_gateway.json", "config_ui_map.json"],
      "secret_file": "config_app_secret.json"
    },
    "import_line": "^\\s*import\\b",
    "import_named": "^\\s*import\\s*\\{([^}]*)\\}\\s*from\\s*['\"]\\./([A-Za-z0-9_]+)\\.js['\"]\\s*;?\\s*$",
    "import_star": "^\\s*import\\s*\\*\\s*as\\s+([A-Za-z_$][\\w$]*)\\s+from\\s*['\"]\\./([A-Za-z0-9_]+)\\.js['\"]\\s*;?\\s*$",
    "needs_decl": "export\\s+const\\s+NEEDS\\s*=\\s*\\[([^\\]]*)\\]",
    "kind_decl": "export\\s+const\\s+KIND\\s*=\\s*['\"]([a-z_]+)['\"]",
    "kind_layer": {"board": "screen"},
    "deps_use":"\\bdeps\\s*\\.\\s*([A-Za-z_$][\\w$]*)",
    "imports_allowed": {
      "app": "*",
      "ui_map": ["mapview"]
    },
    "module_layer": {
      "cfg": "cfg",
      "timefmt": "pure",
      "health": "pure",
      "statecalc": "pure",
      "geo": "pure",
      "fixcheck": "pure",
      "locate": "pure",
      "speed": "pure",
      "relay_parse": "pure",
      "board": "pure",
      "disk_web": "platform",
      "log": "log",
      "store": "store",
      "state": "state",
      "netcore": "netcore",
      "startprobe": "client",
      "loc_watch": "client",
      "relay_base": "client",
      "relay_stations": "client",
      "healthrunner": "runner",
      "calcrunner": "runner",
      "mapview": "screen_part",
      "ui_status": "screen",
      "ui_drive": "screen",
      "ui_map": "screen",
      "ui_log": "screen",
      "ui_boards": "screen",
      "app": "app"
    },
    "layer_may_need": {
      "pure": [],
      "platform": ["platform"],
      "cfg": [],
      "log": ["cfg", "pure", "platform"],
      "store": ["cfg", "log", "pure", "platform"],
      "state": ["cfg", "log", "pure", "platform"],
      "netcore": ["cfg", "log", "pure", "platform"],
      "client": ["cfg", "log", "store", "state", "pure", "platform"],
      "runner": ["cfg", "log", "store", "state", "pure", "platform"],
      "screen_part": ["pure", "platform"],
      "screen": ["cfg", "log", "store", "state", "pure", "platform"],
      "app": ["*"]
    },
    "extra_needs": {
      "startprobe": ["netcore"],
      "loc_watch": ["netcore"],
      "relay_base": ["netcore"],
      "relay_stations": ["relay_base"],
      "ui_map": ["mapview"]
    },
    "dep_module": {
      "cfg": "cfg",
      "log": "log",
      "store": "store",
      "state": "state",
      "netcore": "netcore",
      "timefmt": "timefmt",
      "health": "health",
      "statecalc": "statecalc",
      "disk": "disk_web",
      "mapview": "mapview",
      "geomath": "geo",
      "fixcheck": "fixcheck",
      "relay_base": "relay_base",
      "relay_parse": "relay_parse",
      "board": "board"
    },
    "platform_deps": ["platform", "doc", "win", "fetch", "clock", "console", "geo", "maplibre", "storage", "boards", "parts"],
    "banned_everywhere": [
      "\\bnew\\s+(Logger|Store|Config|State)\\b",
      "\\bgetInstance\\b",
      "(?<![.\\w$])window\\s*\\.",
      "(?<![.\\w$])document\\s*\\.",
      "(?<![.\\w$])navigator\\s*\\.",
      "\\bglobalThis\\b",
      "\\brequire\\s*\\(",
      "\\bimport\\s*\\("
    ],
    "banned_in": {
      "calcrunner": ["health", "conn\\."],
      "statecalc": ["health", "conn\\."]
    },
    "banned_in_layer": {
      "screen": ["\\bnetcore\\b", "\\bstartprobe\\b", "\\bloc_watch\\b", "\\brelay_base\\b", "\\brelay_stations\\b", "\\bfetch\\b", "\\bRelayClient\\b", "\\bRouteClient\\b", "\\bLocationClient\\b"],
      "pure": ["\\bdeps\\b", "\\blog\\s*\\.", "\\bLogger\\b"]
    }
  },
  "vendor": {
    "package": "maplibre-gl",
    "version": "5.24.1",
    "npm": "npm",
    "out_dir": "vendor",
    "files": {
      "package/dist/maplibre-gl.js": "maplibre-gl.js",
      "package/dist/maplibre-gl.css": "maplibre-gl.css",
      "package/LICENSE.txt": "maplibre-gl.LICENSE.txt"
    },
    "tar_block": 512,
    "tar_name_len": 100,
    "tar_size_at": 124,
    "tar_size_len": 12,
    "tar_type_at": 156,
    "tar_prefix_at": 345,
    "tar_prefix_len": 155,
    "tar_octal": 8,
    "tar_file_types": ["0", "\u0000", ""]
  },
  "testbed": {
    "note": "테스트 베드(읽기만). 경로는 web2 기준. 다리는 시험 모드(돈 초만 돌고 스스로 끝남)로만 띄운다",
    "dir": "../testbed",
    "config": "config/testbed.json",
    "python": "py",
    "python_args": ["-X", "utf8"],
    "secret_bytes": 24,
    "secret_file_name": "config_app_secret.json",
    "health_wait_ms": 20000,
    "poll_ms": 200,
    "lines_note": "R0(중계가 만드는 고속도로 선 파일) 전이라 시험 다리가 선을 내주지 않는다. 시험·보기 도구만 다리 자료 길의 이 선 파일 이름을 테스트 베드 선 파일로 대신 답한다(앱 코드는 그대로 다리 자료 길에 묻는다). 비밀 값 머리가 틀리면 다리처럼 lock",
    "lines_shim": {"lines/gyeongbu_down.json": "gyeongbu_down"},
    "json_type": "application/json; charset=utf-8",
    "lock_status": 401,
    "lock_body": {"v": 1, "ok": false, "code": "lock", "src": "gate"}
  },
  "try_a1": {
    "run_seconds": 140,
    "exit_grace_ms": 20000,
    "s1_scene": "S1_고속도로",
    "s1_listen_ms": 9000,
    "s1_min_fixes": 6,
    "tick_ms": 1000,
    "tick_tolerance_ms": 300,
    "line_tolerance_m": 40,
    "step_tolerance_ratio": 0.3,
    "kmh_to_mps": 0.2777777777777778,
    "earth_radius_m": 6371008.8,
    "deg_to_rad": 0.017453292519943295,
    "start_wait_ms": 20000,
    "startup_cases": [
      {"scene": "S8_켤때실패_목록", "title": "켤 때 실패 — 충전소 목록 못 줌", "expect": {"stage": "broken", "code": "need", "need": "stations", "text": ["texts.broken", "texts.need_names.stations"]}},
      {"scene": "S8_켤때실패_비밀값", "title": "켤 때 실패 — 비밀 값 틀림(다리 401)", "expect": {"stage": "broken", "code": "need", "fail": "lock", "text": ["texts.broken", "texts.need_fail.lock"]}},
      {"scene": "S8_켤때실패_다리주소", "title": "켤 때 실패 — 다리 주소 틀림(답 없이 닫힘)", "expect": {"stage": "broken", "code": "need", "fail": "offline", "text": ["texts.broken"]}}
    ],
    "bad_gateway_url": "http://evil.example:8787",
    "break_app_config": {"file": "config_netcore", "path": "clients.start.timeout_ms", "value": -5},
    "break_feature_config": {"file": "config_loc_watch", "path": "source", "value": "nope", "feature": "health.loc"},
    "page_listen_ms": 6000,
    "vendor_head_chars": 200,
    "mask_probe_where": "try_a1",
    "mask_probe_what": "mask_probe",
    "report_file": "try_a1_last.md"
  },
  "try_a2ga": {
    "note": "A2-가 스스로 시험(try_a2ga.mjs). 장면은 seek 로 그 사건 앞 틱부터 — 앱은 경우마다 새로 띄운다(옮긴 자리를 튐으로 보지 않게). refresh_override_ms 는 끊김·나쁜 자료 시험에서만 앱의 다시 받기 간격을 줄이는 값(앱 설정 파일은 그대로)",
    "run_seconds": 360,
    "exit_grace_ms": 20000,
    "start_wait_ms": 20000,
    "refresh_override_ms": 3000,
    "line_tolerance_m": 40,
    "tick_ms": 1000,
    "s1": {"scene": "S1_고속도로", "listen_ms": 10000, "min_fixes": 6, "km_start": 28.0, "kmh": 95, "km_tolerance": 0.3},
    "s2": {"scene": "S2_제한속도", "seek": 470, "listen_ms": 6000, "kmh": 115},
    "s6": {"scene": "S6_정차출발튐", "lead_ticks": 6, "after_ticks": 4, "cases": [
      {"t_s": 100, "ticks": 2, "title": "달리는 중 400 m 튐", "stopped": false},
      {"t_s": 250, "ticks": 5, "title": "멈춘 중 60 m 흔들림", "stopped": true},
      {"t_s": 470, "ticks": 1, "title": "다시 달릴 때 1.5 km 튐", "stopped": false}
    ], "jump_code": "jump"},
    "s7": {"scene": "S7_출처끊김", "seek": 172, "down_t_s": 180, "up_t_s": 240, "down_wait_ms": 40000, "up_wait_ms": 90000},
    "s11": {"scene": "S11_나쁜자료", "lead_ticks": 4, "after_ticks": 4,
      "stream_cases": [
        {"t_s": 30, "ticks": 3, "title": "흐름 — 범위 밖 좌표", "word": "fix_bad", "why": "range", "min": 3},
        {"t_s": 60, "ticks": 3, "title": "흐름 — 음수 속도", "word": "fix_bad", "why": "speed_neg", "min": 3},
        {"t_s": 90, "ticks": 2, "title": "흐름 — 깨진 JSON", "word": "parse", "why": null, "min": 1},
        {"t_s": 120, "ticks": 1, "title": "흐름 — 너무 큰 답", "word": "stream_down", "why": "too_big", "min": 1}
      ],
      "data_cases": [
        {"t_s": 150, "title": "자료 길 — 깨진 JSON", "code": "parse", "word": "stations_refresh_fail"},
        {"t_s": 240, "title": "자료 길 — 범위 밖 좌표", "code": "bad", "word": "bad_items"},
        {"t_s": 330, "title": "자료 길 — 너무 큰 답", "code": "too_big", "word": "stations_refresh_fail"}
      ],
      "data_listen_ms": 12000},
    "e4": {
      "copy": ["src", "config", "vendor", "shell.html"],
      "remove_board": "ui_speed",
      "trial_board": "ui_trial",
      "renames": {"config_ui_speed": "config_ui_trial", "ev-speed": "ev-trial"},
      "trial_slot_from": "\"slot\": \"left\"",
      "trial_slot_to": "\"slot\": \"right\"",
      "untouched": ["src/app.js", "src/ui_drive.js", "src/ui_boards.js", "src/view_ui_drive.html"],
      "listen_ms": 5000
    },
    "view": {"seconds": 25, "scene": "S2_제한속도", "tick": 470, "kmh": 115, "listen_ms": 5000, "ready_word": "크롬에서 여세요"},
    "vendor_head_chars": 200,
    "report_file": "try_a2ga_last.md"
  },
  "speedfit": {
    "note": "속도판 세 자리 시험(try_speedfit.mjs). widths_px = 가상 창에서 판 폭으로 넣어 볼 값(0 = 그려지기 전 — 설정 판 폭으로 셈). slot_pad_px = 자리 안쪽 여백(style_ui_boards.css .ev-slot-side padding 8px × 2)",
    "board": "ui_speed",
    "config": "config_ui_speed",
    "boards_config": "config_ui_boards",
    "widths_px": [240, 160, 144, 128, 112, 96, 80],
    "values": [199, 115, 95, 0],
    "slot_pad_px": 16
  },
  "view_s1": {
    "note": "묘성이 크롬으로 S1 을 보는 길: 빌드(임시 폴더) + 다리(시험 모드) + 작은 웹 서버를 같은 초만 띄운다",
    "host": "127.0.0.1",
    "port": 5173,
    "default_seconds": 600,
    "max_seconds": 3600,
    "content_type": "text/html; charset=utf-8",
    "ms_per_s": 1000,
    "scheme": "http://",
    "gateway_config": "config_gateway",
    "override_file": "view_override.json",
    "gateway_prefix": "/v1/",
    "proxy_fail_status": 502
  },
  "hook": {
    "script": "tools/hooks/pre-commit-web2.sh",
    "hook_name": "pre-commit",
    "line": "sh web2/tools/hooks/pre-commit-web2.sh || exit 1",
    "shebang": "#!/bin/sh"
  }
}
