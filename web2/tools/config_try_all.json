    {"file": "try_a3.mjs", "args": ["chrome"], "limit_s": 240},
    {"file": "try_a4.mjs", "args": ["pure"], "limit_s": 120},
    {"file": "try_a4.mjs", "args": ["app"], "limit_s": 420},
    {"file": "try_a4.mjs", "args": ["chrome"], "limit_s": 240},
    {"file": "try_a5.mjs", "args": ["pure"], "limit_s": 120},
    {"file": "try_a5.mjs", "args": ["app"], "limit_s": 540},
