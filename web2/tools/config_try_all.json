    {"file": "try_a5.mjs", "args": ["chrome", "over"], "limit_s": 240},
    {"file": "try_a5.mjs", "args": ["chrome", "none"], "limit_s": 240},
    {"file": "try_a6.mjs", "args": ["pure"], "limit_s": 120},
    {"file": "try_a6.mjs", "args": ["app"], "limit_s": 660},
    {"file": "try_a6.mjs", "args": ["chrome"], "limit_s": 240},
    {"file": "try_a7.mjs", "args": ["pure"], "limit_s": 180},
    {"file": "try_a7.mjs", "args": ["app"], "limit_s": 300},
    {"file": "try_a7.mjs", "args": ["s12"], "limit_s": 420, "s12": true},
    {"file": "try_a7.mjs", "args": ["chrome"], "limit_s": 240},
    {"file": "try_a7.mjs", "args": ["shots"], "limit_s": 240},
